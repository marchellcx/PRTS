<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <RootNamespace>PRTS</RootNamespace>
        <AssemblyName>PRTS</AssemblyName>
        <PackageId>PRTS</PackageId>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="NiveraAPI">
        <HintPath>$(PLUGIN_REFS)\NiveraAPI.dll</HintPath>
      </Reference>
      <Reference Include="System.Runtime.CompilerServices.Unsafe">
        <HintPath>$(PLUGIN_REFS)\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Discord.Net" Version="3.20.1" />
      <PackageReference Include="FastGenericNew" Version="3.3.1" />
      <PackageReference Include="Fergun.Interactive" Version="1.9.2" />
      <PackageReference Include="Lib.Harmony" Version="2.4.2" />
      <PackageReference Include="LiteNetLib" Version="2.1.4" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.6.26359.118" />
      <PackageReference Include="MimeTypesMap" Version="1.0.9" />
      <PackageReference Include="System.Net.Http" Version="4.3.4" />
      <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>

</Project>
